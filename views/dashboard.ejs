<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="dash-layout">
  <%- include('partials/sidebar-user') %>
  <div class="dash-content">
    <button class="btn btn-ghost btn-sm hide-desktop" id="sidebarToggle" style="margin-bottom: 1rem;">☰ Menu</button>

    <h1 style="font-size: 1.5rem; margin-bottom: 0.25rem;">Welcome, <%= user.name.split(' ')[0] %></h1>
    <p class="text-secondary text-sm mb-2">Here's your API activity overview</p>

    <div class="grid-3" style="margin-bottom: 1.5rem;">
      <div class="card">
        <div class="text-muted text-xs" style="text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.5rem;">Today's Usage</div>
        <% if (user.unlimited || user.role === 'admin') { %>
          <div style="font-size: 1.75rem; font-weight: 800;">∞</div>
          <div class="text-muted text-sm">Unlimited</div>
        <% } else { %>
          <% const pct = Math.min(100, Math.round((user.usedToday / user.dailyLimit) * 100)); %>
          <div style="font-size: 1.75rem; font-weight: 800;"><%= user.usedToday %> <span class="text-muted" style="font-size:1rem;font-weight:500;">/ <%= user.dailyLimit %></span></div>
          <div class="usage-bar"><div class="usage-fill <%= pct >= 90 ? 'danger' : pct >= 70 ? 'warning' : '' %>" style="width:<%= pct %>%"></div></div>
          <div class="text-muted text-sm"><%= Math.max(0, user.dailyLimit - user.usedToday) %> remaining</div>
        <% } %>
      </div>
      <div class="card">
        <div class="text-muted text-xs" style="text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.5rem;">Total Requests</div>
        <div style="font-size: 1.75rem; font-weight: 800;"><%= user.totalRequests || 0 %></div>
        <div class="text-muted text-sm">All time</div>
      </div>
      <div class="card">
        <div class="text-muted text-xs" style="text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.5rem;">Account</div>
        <div style="font-size: 1.1rem; font-weight: 700; text-transform: capitalize;"><%= user.role %></div>
        <div class="flex items-center gap-1 mt-1">
          <span class="status-dot <%= user.status === 'active' ? 'online' : 'offline' %>"></span>
          <span class="text-sm text-muted" style="text-transform:capitalize"><%= user.status %></span>
        </div>
      </div>
    </div>

    <div class="card mb-2">
      <div class="flex justify-between items-center" style="margin-bottom: 1rem;">
        <h3 style="font-size: 1rem;">Your API Key</h3>
        <a href="/user/api-key" class="btn btn-ghost btn-sm">Manage</a>
      </div>
      <div class="code-block flex justify-between items-center" style="gap: 1rem;">
        <code id="dashApiKey" class="mono" data-full="<%= user.apiKey %>" data-hidden="1"><%= user.apiKey.replace(/.(?=.{4})/g, '•') %></code>
        <div class="flex gap-1">
          <button class="copy-btn" data-toggle-key="#dashApiKey">Show</button>
          <button class="copy-btn" onclick="copyText('<%= user.apiKey %>', this)">Copy</button>
        </div>
      </div>
      <p class="text-muted text-xs mt-1">Use in URL: <code class="mono">/api/{category}/{endpoint}-key/<%= user.apiKey.slice(0,8) %>...</code></p>
    </div>

    <div class="card">
      <h3 style="font-size: 1rem; margin-bottom: 1rem;">Recent Requests</h3>
      <% if (recentLogs && recentLogs.length) { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Endpoint</th><th>Status</th><th>Time</th><th>When</th></tr>
            </thead>
            <tbody>
              <% recentLogs.forEach(function(log) { %>
                <tr>
                  <td class="mono text-sm"><%= log.endpoint %></td>
                  <td><span class="badge <%= log.success ? 'badge-get' : 'badge-delete' %>"><%= log.statusCode %></span></td>
                  <td class="text-muted"><%= log.responseTime %>ms</td>
                  <td class="text-muted text-sm"><%= new Date(log.createdAt).toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-muted">No requests yet. <a href="/explorer">Explore APIs</a> and try one!</p>
      <% } %>
    </div>
  </div>
</div>

<script src="/js/main.js"></script>
<style>@media(min-width:901px){.hide-desktop{display:none!important}}</style>
</div>
</body>
</html>
