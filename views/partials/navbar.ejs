<header class="navbar" id="navbar">
  <div class="nav-container">
    <a href="/" class="nav-brand">
      <span class="brand-icon">⚡</span>
      <span class="brand-text">Sam<span class="accent">Api</span></span>
    </a>

    <nav class="nav-links" id="navLinks">
      <a href="/" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/explorer" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/explorer') ? 'active' : '' %>">Explorer</a>
      <a href="/docs" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/docs') ? 'active' : '' %>">Docs</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/user/dashboard" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/user') ? 'active' : '' %>">Dashboard</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="nav-link admin-link">Admin</a>
        <% } %>
      <% } %>
    </nav>

    <div class="nav-actions">
      <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme" title="Toggle theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>

      <% if (typeof user !== 'undefined' && user) { %>
        <div class="user-menu">
          <button class="user-btn" id="userMenuBtn" aria-haspopup="true">
            <img src="<%= user.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name || 'U') + '&background=6366f1&color=fff' %>" alt="" class="avatar-sm" width="32" height="32">
            <span class="user-name hide-mobile"><%= (user.name || 'User').split(' ')[0] %></span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="dropdown" id="userDropdown">
            <div class="dropdown-header">
              <strong><%= user.name %></strong>
              <span class="text-muted"><%= user.email || '' %></span>
            </div>
            <a href="/user/dashboard">Dashboard</a>
            <a href="/user/account">Account</a>
            <a href="/user/api-key">API Key</a>
            <a href="/user/usage">Usage</a>
            <% if (user.role === 'admin') { %>
              <a href="/admin">Admin Panel</a>
            <% } %>
            <div class="dropdown-divider"></div>
            <a href="/logout" class="text-danger">Sign out</a>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="btn btn-primary btn-sm">Sign in</a>
      <% } %>

      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
<div class="mobile-nav" id="mobileNav">
  <a href="/">Home</a>
  <a href="/explorer">API Explorer</a>
  <a href="/docs">Documentation</a>
  <% if (typeof user !== 'undefined' && user) { %>
    <a href="/user/dashboard">Dashboard</a>
    <a href="/user/account">Account</a>
    <a href="/user/api-key">API Key</a>
    <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
    <a href="/logout">Sign out</a>
  <% } else { %>
    <a href="/login" class="btn btn-primary">Sign in with Google</a>
  <% } %>
</div>
