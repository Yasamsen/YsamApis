<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="nav-brand">
        <span class="brand-icon">⚡</span>
        <span class="brand-text">Sam<span class="accent">Api</span></span>
      </a>
      <p class="footer-desc">Powerful, fast and reliable APIs for modern developers. Build, explore and integrate with ease.</p>
    </div>
    <div class="footer-col">
      <h4>Product</h4>
      <a href="/explorer">API Explorer</a>
      <a href="/docs">Documentation</a>
      <a href="/login">Get API Key</a>
    </div>
    <div class="footer-col">
      <h4>Legal</h4>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
    </div>
    <div class="footer-col">
      <h4>Status</h4>
      <div class="status-row">
        <span class="status-dot online"></span>
        <span>All systems operational</span>
      </div>
      <% if (typeof manifest !== 'undefined' && manifest) { %>
        <p class="text-muted text-sm"><%= manifest.online || 0 %> / <%= manifest.total || 0 %> APIs online</p>
      <% } %>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <span>© <%= new Date().getFullYear() %> SamApi. Built for developers.</span>
    </div>
  </div>
</footer>
