<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <div class="flex items-center gap-1" style="gap: 0.75rem; margin-bottom: 0.35rem;">
          <h1 class="section-title" style="margin:0;"><%= endpoint.name %></h1>
          <span class="badge badge-<%= endpoint.method.toLowerCase() %>"><%= endpoint.method %></span>
        </div>
        <p class="section-desc"><%= endpoint.description %></p>
      </div>
      <a href="/docs/<%= endpoint.category.toLowerCase() %>/<%= endpoint.id.split('/')[1] %>" class="btn btn-secondary btn-sm">Full Docs</a>
    </div>

    <div class="playground">
      <div class="playground-panel">
        <div class="playground-header">Request</div>
        <div class="playground-body">
          <div class="form-group">
            <label class="form-label">Endpoint</label>
            <div class="code-block mono text-sm" id="requestUrlPreview"><%= endpoint.endpoint %></div>
          </div>

          <% (endpoint.parameters || []).forEach(function(p) { %>
            <div class="form-group">
              <label class="form-label" for="param_<%= p.name %>">
                <%= p.name %>
                <% if (p.required) { %><span style="color:var(--danger)">*</span><% } %>
                <span class="text-muted" style="font-weight:400;">(<%= p.type %>)</span>
              </label>
              <input class="form-input param-input" id="param_<%= p.name %>" name="<%= p.name %>" data-name="<%= p.name %>" placeholder="<%= p.description || p.name %>" <%= p.required ? 'required' : '' %> value="<%= p.default || '' %>">
            </div>
          <% }) %>

          <% if (!user) { %>
            <div class="form-group">
              <label class="form-label">API Key <span style="color:var(--danger)">*</span></label>
              <input class="form-input" id="manualApiKey" placeholder="sk_xxxxxxxxxxxx" required>
              <p class="text-muted text-xs mt-1"><a href="/login">Sign in</a> to auto-fill your key.</p>
            </div>
          <% } else { %>
            <p class="text-muted text-sm mb-2">Using your API key automatically.</p>
          <% } %>

          <button class="btn btn-primary btn-block" id="sendRequest">Send Request</button>
        </div>
      </div>

      <div class="playground-panel">
        <div class="playground-header">
          <span>Response</span>
          <span id="responseMeta" class="text-muted text-xs"></span>
        </div>
        <div class="playground-body">
          <pre class="code-block" id="responseBody" style="min-height: 200px; white-space: pre-wrap; word-break: break-word;">// Response will appear here</pre>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
<script>
(function() {
  const endpoint = <%- JSON.stringify(endpoint) %>;
  const userKey = <%- user && user.apiKey ? JSON.stringify(user.apiKey) : 'null' %>;
  const baseUrl = window.location.origin;

  const sendBtn = document.getElementById('sendRequest');
  const responseBody = document.getElementById('responseBody');
  const responseMeta = document.getElementById('responseMeta');
  const preview = document.getElementById('requestUrlPreview');

  function buildUrl() {
    const key = userKey || (document.getElementById('manualApiKey') && document.getElementById('manualApiKey').value) || '{key}';
    const slug = endpoint.id.split('/')[1];
    const cat = endpoint.category.toLowerCase();
    let url = `${baseUrl}/api/${cat}/${slug}-key/${key}`;
    const params = new URLSearchParams();
    document.querySelectorAll('.param-input').forEach(inp => {
      if (inp.value) params.set(inp.dataset.name, inp.value);
    });
    const qs = params.toString();
    if (qs) url += '?' + qs;
    return url;
  }

  function updatePreview() {
    preview.textContent = buildUrl().replace(baseUrl, '');
  }
  document.querySelectorAll('.param-input').forEach(i => i.addEventListener('input', updatePreview));
  const manKey = document.getElementById('manualApiKey');
  if (manKey) manKey.addEventListener('input', updatePreview);
  updatePreview();

  sendBtn.addEventListener('click', async () => {
    const key = userKey || (document.getElementById('manualApiKey') && document.getElementById('manualApiKey').value);
    if (!key || key === '{key}') {
      showToast('API key required. Sign in or enter your key.', 'error');
      return;
    }
    const url = buildUrl();
    sendBtn.disabled = true;
    sendBtn.textContent = 'Sending...';
    responseBody.textContent = 'Loading...';
    responseMeta.textContent = '';

    const t0 = performance.now();
    try {
      const res = await fetch(url, { method: endpoint.method || 'GET' });
      const ms = Math.round(performance.now() - t0);
      const data = await res.json().catch(() => ({ status: false, message: 'Invalid JSON response' }));
      responseMeta.textContent = `${res.status} · ${ms}ms`;
      responseBody.textContent = JSON.stringify(data, null, 2);
      if (!res.ok) showToast(data.message || 'Request failed', 'error');
    } catch (err) {
      responseBody.textContent = JSON.stringify({ status: false, message: err.message }, null, 2);
      responseMeta.textContent = 'Error';
      showToast('Network error', 'error');
    }
    sendBtn.disabled = false;
    sendBtn.textContent = 'Send Request';
  });
})();
</script>
</div>
</body>
</html>
