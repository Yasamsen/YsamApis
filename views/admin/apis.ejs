<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="section">
  <div class="container">
    <div class="section-header">
      <h1 class="section-title">API Management</h1>
      <div class="flex gap-1">
        <form method="POST" action="/admin/apis/reload">
          <button class="btn btn-primary btn-sm" type="submit">Reload Manifest</button>
        </form>
        <a href="/admin" class="btn btn-ghost btn-sm">Back</a>
      </div>
    </div>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead><tr><th>Name</th><th>Category</th><th>Method</th><th>Status</th><th>Endpoint</th></tr></thead>
          <tbody>
            <% (endpoints || []).forEach(function(ep) { %>
              <tr>
                <td style="font-weight:600;"><%= ep.name %></td>
                <td><span class="badge badge-cat"><%= ep.category %></span></td>
                <td><span class="badge badge-<%= ep.method.toLowerCase() %>"><%= ep.method %></span></td>
                <td><span class="status-dot <%= ep.status %>"></span> <%= ep.status %></td>
                <td class="mono text-xs"><%= ep.endpoint %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
</div></body></html>
