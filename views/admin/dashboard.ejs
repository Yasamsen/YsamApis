<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="section">
  <div class="container">
    <h1 class="section-title" style="margin-bottom:1.5rem;">Admin Dashboard</h1>
    <div class="grid-3" style="margin-bottom:1.5rem;">
      <div class="card"><div class="text-muted text-xs" style="text-transform:uppercase;">Total Users</div><div style="font-size:1.75rem;font-weight:800;"><%= stats.totalUsers %></div></div>
      <div class="card"><div class="text-muted text-xs" style="text-transform:uppercase;">Total APIs</div><div style="font-size:1.75rem;font-weight:800;"><%= stats.totalApis %></div><div class="text-muted text-sm"><%= stats.onlineApis %> online</div></div>
      <div class="card"><div class="text-muted text-xs" style="text-transform:uppercase;">Requests Today</div><div style="font-size:1.75rem;font-weight:800;"><%= stats.requestsToday %></div><div class="text-muted text-sm"><%= stats.requestsMonth %> this month</div></div>
    </div>
    <div class="flex gap-1 mb-2" style="flex-wrap:wrap;">
      <a href="/admin/users" class="btn btn-secondary">User Management</a>
      <a href="/admin/apis" class="btn btn-secondary">API Management</a>
      <a href="/admin/logs" class="btn btn-secondary">API Logs</a>
      <a href="/admin/stats" class="btn btn-secondary">Statistics</a>
    </div>
    <div class="card">
      <h3 style="font-size:1rem;margin-bottom:1rem;">Last 7 Days Requests</h3>
      <div class="flex items-center gap-1" style="gap:0.5rem; height:120px; align-items:flex-end;">
        <% (dailyStats||[]).forEach(function(d){ 
          const max = Math.max(1, ...dailyStats.map(x=>x.count));
          const h = Math.round((d.count / max) * 100);
        %>
          <div style="flex:1; text-align:center;">
            <div style="background:var(--gradient-1); height:<%= h %>px; min-height:4px; border-radius:6px 6px 0 0; margin-bottom:0.35rem;" title="<%= d.count %>"></div>
            <div class="text-xs text-muted"><%= d.label %></div>
          </div>
        <% }) %>
      </div>
    </div>
    <div class="card mt-2">
      <h3 style="font-size:1rem;margin-bottom:1rem;">Recent Activity</h3>
      <% if (recentLogs && recentLogs.length) { %>
        <div class="table-wrap"><table>
          <thead><tr><th>User</th><th>Endpoint</th><th>Status</th><th>Time</th></tr></thead>
          <tbody>
            <% recentLogs.forEach(function(l){ %>
              <tr>
                <td class="text-sm"><%= l.userId ? (l.userId.name || l.userId.email) : '—' %></td>
                <td class="mono text-sm"><%= l.endpoint %></td>
                <td><span class="badge <%= l.success?'badge-get':'badge-delete' %>"><%= l.statusCode %></span></td>
                <td class="text-muted text-sm"><%= new Date(l.createdAt).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table></div>
      <% } else { %><p class="text-muted">No logs yet.</p><% } %>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
</div></body></html>
