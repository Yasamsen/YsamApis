<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="section">
  <div class="container">
    <div class="section-header">
      <h1 class="section-title">API Logs</h1>
      <a href="/admin" class="btn btn-ghost btn-sm">Back</a>
    </div>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead><tr><th>User</th><th>Endpoint</th><th>Status</th><th>Time</th><th>Date</th></tr></thead>
          <tbody>
            <% (logs || []).forEach(function(l) { %>
              <tr>
                <td class="text-sm"><%= l.userId ? (l.userId.name || l.userId.email || '—') : '—' %></td>
                <td class="mono text-sm"><%= l.endpoint %></td>
                <td><span class="badge <%= l.success ? 'badge-get' : 'badge-delete' %>"><%= l.statusCode %></span></td>
                <td><%= l.responseTime %>ms</td>
                <td class="text-muted text-sm"><%= new Date(l.createdAt).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (pagination && pagination.total > 1) { %>
        <div class="flex gap-1 mt-2" style="justify-content:center;">
          <% if (pagination.current > 1) { %><a class="btn btn-secondary btn-sm" href="?page=<%= pagination.current - 1 %>">Prev</a><% } %>
          <span class="text-muted text-sm" style="align-self:center;">Page <%= pagination.current %> / <%= pagination.total %></span>
          <% if (pagination.current < pagination.total) { %><a class="btn btn-secondary btn-sm" href="?page=<%= pagination.current + 1 %>">Next</a><% } %>
        </div>
      <% } %>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
</div></body></html>
