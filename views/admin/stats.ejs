<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="section">
  <div class="container">
    <div class="section-header">
      <h1 class="section-title">Usage Statistics</h1>
      <a href="/admin" class="btn btn-ghost btn-sm">Back</a>
    </div>
    <div class="grid-2">
      <div class="card">
        <h3 style="font-size:1rem;margin-bottom:1rem;">Top Endpoints</h3>
        <% if (topEndpoints && topEndpoints.length) { %>
          <div class="table-wrap"><table>
            <thead><tr><th>Endpoint</th><th>Requests</th></tr></thead>
            <tbody>
              <% topEndpoints.forEach(function(e) { %>
                <tr><td class="mono text-sm"><%= e._id %></td><td><%= e.count %></td></tr>
              <% }) %>
            </tbody>
          </table></div>
        <% } else { %><p class="text-muted">No data yet.</p><% } %>
      </div>
      <div class="card">
        <h3 style="font-size:1rem;margin-bottom:1rem;">Top Users</h3>
        <% if (topUsers && topUsers.length) { %>
          <div class="table-wrap"><table>
            <thead><tr><th>User</th><th>Requests</th></tr></thead>
            <tbody>
              <% topUsers.forEach(function(u) { %>
                <tr>
                  <td class="text-sm"><%= u.user ? (u.user.name || u.user.email) : '—' %></td>
                  <td><%= u.count %></td>
                </tr>
              <% }) %>
            </tbody>
          </table></div>
        <% } else { %><p class="text-muted">No data yet.</p><% } %>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
</div></body></html>
