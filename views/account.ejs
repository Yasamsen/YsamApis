<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="dash-layout">
  <%- include('partials/sidebar-user') %>
  <div class="dash-content">
    <h1 style="font-size: 1.5rem; margin-bottom: 1.5rem;">Account</h1>

    <div class="card" style="max-width: 560px;">
      <div class="flex items-center gap-1" style="gap: 1rem; margin-bottom: 1.5rem;">
        <img src="<%= user.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name) + '&background=6366f1&color=fff&size=80' %>" alt="" width="64" height="64" style="border-radius:50%; object-fit:cover;">
        <div>
          <div style="font-weight:700; font-size:1.15rem;"><%= user.name %></div>
          <div class="text-muted text-sm"><%= user.email %></div>
          <div class="flex items-center gap-1 mt-1">
            <span class="badge badge-cat" style="text-transform:uppercase"><%= user.role %></span>
            <span class="status-dot <%= user.status === 'active' ? 'online' : 'offline' %>"></span>
            <span class="text-xs text-muted" style="text-transform:capitalize"><%= user.status %></span>
          </div>
        </div>
      </div>

      <div class="grid-2" style="gap: 1rem;">
        <div>
          <div class="text-muted text-xs" style="text-transform:uppercase; letter-spacing:0.04em;">Daily Limit</div>
          <div style="font-weight:700; font-size:1.25rem;">
            <% if (user.unlimited || user.role === 'admin') { %>∞ Unlimited<% } else { %><%= user.dailyLimit %> requests<% } %>
          </div>
        </div>
        <div>
          <div class="text-muted text-xs" style="text-transform:uppercase; letter-spacing:0.04em;">Used Today</div>
          <div style="font-weight:700; font-size:1.25rem;">
            <% if (user.unlimited || user.role === 'admin') { %>∞<% } else { %><%= user.usedToday %> / <%= user.dailyLimit %><% } %>
          </div>
        </div>
        <div>
          <div class="text-muted text-xs" style="text-transform:uppercase; letter-spacing:0.04em;">Total Requests</div>
          <div style="font-weight:700; font-size:1.25rem;"><%= user.totalRequests || 0 %></div>
        </div>
        <div>
          <div class="text-muted text-xs" style="text-transform:uppercase; letter-spacing:0.04em;">Member Since</div>
          <div style="font-weight:600;"><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : '—' %></div>
        </div>
      </div>

      <% if (!(user.unlimited || user.role === 'admin')) { %>
        <% const pct = Math.min(100, Math.round((user.usedToday / user.dailyLimit) * 100)); %>
        <div style="margin-top: 1.25rem;">
          <div class="text-muted text-xs mb-1">Today's progress</div>
          <div class="usage-bar"><div class="usage-fill <%= pct >= 90 ? 'danger' : pct >= 70 ? 'warning' : '' %>" style="width:<%= pct %>%"></div></div>
          <div class="text-muted text-sm">Resets at midnight UTC</div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script src="/js/main.js"></script>
</div>
</body>
</html>
