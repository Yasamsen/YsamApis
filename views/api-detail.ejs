<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="section">
  <div class="container" style="max-width: 860px;">
    <div class="flex items-center gap-1" style="gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
      <h1 class="section-title" style="margin:0;"><%= endpoint.name %></h1>
      <span class="badge badge-<%= endpoint.method.toLowerCase() %>"><%= endpoint.method %></span>
      <span class="badge badge-cat"><%= endpoint.category %></span>
      <span class="status-dot <%= endpoint.status %>"></span>
    </div>
    <p class="text-secondary mb-2"><%= endpoint.description %></p>

    <div class="card mb-2">
      <div class="text-muted text-xs" style="text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.5rem;">Endpoint</div>
      <div class="code-block mono flex justify-between items-center" style="gap:1rem; flex-wrap:wrap;">
        <span><%= endpoint.endpoint %></span>
        <button class="copy-btn" onclick="copyText('<%= endpoint.endpoint %>', this)">Copy</button>
      </div>
    </div>

    <div class="card mb-2">
      <h3 style="font-size: 1rem; margin-bottom: 1rem;">Parameters</h3>
      <% if (endpoint.parameters && endpoint.parameters.length) { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Name</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
            <tbody>
              <% endpoint.parameters.forEach(function(p) { %>
                <tr>
                  <td class="mono"><%= p.name %></td>
                  <td><%= p.type %></td>
                  <td><%= p.required ? 'Yes' : 'No' %></td>
                  <td class="text-muted"><%= p.description || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-muted">No parameters.</p>
      <% } %>
    </div>

    <div class="card mb-2">
      <h3 style="font-size: 1rem; margin-bottom: 0.75rem;">Authentication</h3>
      <p class="text-secondary text-sm">API key is required in the URL path as <code class="mono">-key/{YOUR_API_KEY}</code>.</p>
      <div class="code-block mono text-sm mt-1">
/api/<%= endpoint.category.toLowerCase() %>/<%= endpoint.id.split('/')[1] %>-key/sk_your_key_here
      </div>
    </div>

    <div class="card mb-2">
      <h3 style="font-size: 1rem; margin-bottom: 0.75rem;">Example Request</h3>
      <div class="code-block mono text-sm">
GET <%= endpoint.endpoint.replace('{key}', 'sk_xxxxx') %><% if (endpoint.parameters && endpoint.parameters.length) { %>?<%= endpoint.parameters.map(p => p.name + '=' + (p.name === 'url' ? 'https://...' : 'value')).join('&') %><% } %>
      </div>
    </div>

    <div class="card mb-2">
      <h3 style="font-size: 1rem; margin-bottom: 0.75rem;">Example Response</h3>
      <pre class="code-block" style="white-space: pre-wrap;"><%= JSON.stringify(endpoint.responseExample || { status: true, creator: 'SamApi', result: {} }, null, 2) %></pre>
    </div>

    <a href="/try/<%= endpoint.category.toLowerCase() %>/<%= endpoint.id.split('/')[1] %>" class="btn btn-primary">Try this API</a>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</div>
</body>
</html>
