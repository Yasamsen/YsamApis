<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="dash-layout">
  <%- include('partials/sidebar-user') %>
  <div class="dash-content">
    <h1 style="font-size: 1.5rem; margin-bottom: 0.5rem;">API Key</h1>
    <p class="text-secondary text-sm mb-2">Your secret key for authenticating API requests. Keep it safe.</p>

    <div class="card" style="max-width: 640px;">
      <div class="text-muted text-xs" style="text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.5rem;">Current Key</div>
      <div class="code-block flex justify-between items-center" style="gap: 1rem; flex-wrap: wrap;">
        <code id="apiKeyDisplay" class="mono" style="word-break: break-all;" data-full="<%= user.apiKey %>" data-hidden="0"><%= user.apiKey %></code>
        <div class="flex gap-1">
          <button class="btn btn-secondary btn-sm" data-toggle-key="#apiKeyDisplay">Hide</button>
          <button class="btn btn-secondary btn-sm" onclick="copyText('<%= user.apiKey %>', this)">Copy</button>
        </div>
      </div>

      <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
        <h3 style="font-size: 0.95rem; margin-bottom: 0.5rem;">Regenerate Key</h3>
        <p class="text-muted text-sm mb-2">This will invalidate your current key immediately. Update all integrations after regenerating.</p>
        <form method="POST" action="/user/api-key/regenerate" onsubmit="return confirm('Regenerate API key? The old key will stop working immediately.');">
          <button type="submit" class="btn btn-secondary">Regenerate API Key</button>
        </form>
      </div>

      <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
        <h3 style="font-size: 0.95rem; margin-bottom: 0.5rem;">How to use</h3>
        <p class="text-muted text-sm mb-1">Include your key in the URL path:</p>
        <div class="code-block mono text-sm">
https://your-domain.com/api/downloader/tiktok-key/<span style="color:var(--accent)"><%= user.apiKey %></span>?url=...
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/main.js"></script>
</div>
</body>
</html>
