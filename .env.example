# Opsional — hanya untuk fitur "requests per day" di halaman /status.
# Tanpa ini, SamApi tetap berjalan normal; halaman status hanya akan
# menampilkan jumlah request sejak cold start instance saat ini
# (bukan total harian), dan menandainya dengan jelas sebagai belum aktif.
#
# Buat database Redis gratis di https://upstash.com lalu isi dua nilai
# di bawah ini pada Environment Variables project Vercel kamu.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
