# MongoDB
MONGODB_URI=mongodb+srv://yasampreset_db_user:yasam01102009@yasam.o2elkbh.mongodb.net/?appName=Yasam
# ========== STORAGE BACKEND ==========
# Pilih salah satu: local | r2 | b2
STORAGE_BACKEND=local

# --- Jika STORAGE_BACKEND=local ---
LOCAL_STORAGE_PATH=./data/files

# --- Jika STORAGE_BACKEND=r2 (Cloudflare R2) ---
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=mystorage
R2_PUBLIC_URL=https://your-bucket.your-account.r2.cloudflarestorage.com

# --- Jika STORAGE_BACKEND=b2 (Backblaze B2) ---
B2_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=mystorage
B2_REGION=us-west-004
# Optional override:
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Session
SESSION_SECRET=e244fa129d39ef25be11dcc1fe62234c754d5485e222d2a9e781ce99c18717e9

# Admin Key (bcrypt hash of your admin access key)
# Generate with: node -e "console.log(require('bcryptjs').hashSync('YOUR_ADMIN_KEY', 12))"
ADMIN_KEY_HASH=$2b$12$X3ZsmWDXOUGvMupZ5uxDJuDIMUOFGHxdw8p83wBAzVrXb16OKO8d2

# Storage limits (bytes) — berlaku untuk local, R2, maupun B2
# 10 GB = 10737418240
STORAGE_LIMIT_BYTES=10737418240
# Alias lama (masih didukung): R2_STORAGE_LIMIT_BYTES=

# 100 MB max per file = 104857600
MAX_FILE_SIZE_BYTES=104857600

# Optional
NODE_ENV=production
